[workspace]
preview = ["pixi-build"]
channels = ["conda-forge"]
platforms = [
  "osx-arm64",
  "linux-64",
  { name = "linux-64-cuda-12", platform = "linux-64", cuda = "12" },
]

[package]
name = "torchsky"
version = "0.4.0.dev0"
description = "Torch-native sky data, coordinates, geometry, and mapmaking"
authors = ["Seb Fabbro <sebfabbro@gmail.com>"]

[package.build]
backend = { name = "pixi-build-cmake", version = "*"}

# Build dependencies - tools needed to build the package
# Note: cmake, ninja, and cxx-compiler are automatically provided by pixi-build-cmake
[package.build-dependencies]
nanobind = ">=2.10.2"
scikit-build-core = ">=0.11.6"
cmake = ">=3.21"
ninja = ">=1.10"
python = ">=3.12,<3.14"
pytorch = ">=2.0"
cfitsio = ">=4"

# Host dependencies - libraries that will be linked into the package
[package.host-dependencies]
python = ">=3.12,<3.14"
pytorch = ">=2.0"
cfitsio = ">=4"
nanobind = ">=2.10.2"

# Run dependencies - packages needed at runtime
[package.run-dependencies]
pytorch = ">=2.0"

psutil = ">=5.0"  # For system resource monitoring
cfitsio = ">=4"

# Workspace dependencies — default (lean) dev shell: build tools + pytest driver only.
# Ecosystem / legacy astronomy packages live in feature `test`, `bench`, `sphere-bench`, etc.
# (see AGENTS.md). Run the suite with `pixi run test`, which executes pytest in `-e test`.
[dependencies]
# torchsky = { path = "." }  # Don't add self-dependency - causes circular dependency
pytest = ">=8.0"
pytest-cov = ">=5.0"
ruff = ">=0.15.5,<0.16"
mypy = ">=1.9"
pip = ">=24.0"
psutil = ">=5.9"
scikit-build-core = ">=0.11.6"
cmake = ">=3.21"
ninja = ">=1.10"
nanobind = ">=2.10.2"
pytorch = ">=2.0"
numpy = ">=1.20"
pre-commit = ">=3.5.0"
healpy = ">=1.19.0,<2"
hpgeom = ">=1.0"
healsparse = ">=1.10"
astropy-healpix = ">=1.0"
spherical-geometry = ">=1.2"

cfitsio = ">=4.4"
tabulate = ">=0.9.0"
twine = ">=5.0"

[tasks]
# Development tasks
dev = "pip install -e . --no-build-isolation"
build = "pixi build"
# Full tests need the `test` env (astropy/fitsio/pyarrow/polars/…); see AGENTS.md.
test = "KMP_DUPLICATE_LIB_OK=TRUE pixi run -e test -- pytest -n auto"
lint = "ruff check . && ruff format ."
# Fast local gate before git push (matches CI code-quality: ruff check only; no file mutations)
preflight-push = "ruff check . && pixi run -e default -- python -m compileall -q src/torchsky tests"
# Mirrors GitHub CI shape: preflight + pyright + full pytest (use before push).
ci-local = "pixi run preflight-push && pixi run typecheck && pixi run test"
# Comparator import smoke (optional; `bench-all` Pixi env). Set TORCHSKY_CI_LOCAL_BENCH=1 to include in custom wrappers.
ci-local-heavy = "pixi run -e bench-all -- python -c \"import healpy, hpgeom, healsparse; import astropy_healpix; import spherical_geometry\""
typecheck = "pixi run -e test pyright"
verify = "pixi run -e default -- python scripts/verify_setup.py"
audit-refactor-cohesion = "pixi run -e default -- python scripts/audit_refactor_cohesion.py"
setup-hooks = "python scripts/install_hooks.py"
pre-commit = "pre-commit run --all-files"
release-manual = "twine upload dist/*"

# Core benchmarks (essential)
bench = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --scope all"
bench-fits = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --fits-only"
bench-fitstable = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --fitstable-only"
bench-wcs = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --wcs-only"
bench-sphere = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --sphere-only"
bench-fast = "pixi run -e bench python benchmarks/bench_fast.py --output benchmark_results/fast_results.csv"
bench-fast-stable = "pixi run -e bench python benchmarks/bench_fast.py --output benchmark_results/fast_results.csv --torch-threads 1 --compressed-repeats 3"
bench-core = "pixi run -e bench python benchmarks/bench_fast.py"
bench-table = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --fitstable-only"
bench-table-arrow = "pixi run -e bench python benchmarks/bench_arrow_tables.py"
bench-table-arrow-diverse = "pixi run -e bench python benchmarks/bench_arrow_tables_diverse.py"
bench-ml-loader = "pixi run -e bench python benchmarks/bench_ml_loader.py"
bench-map-image-plane = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_image_plane.py --json-out benchmark_results/map_image_plane.json"
bench-map-compat = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_compat.py --json-out benchmark_results/map_compat.json"
bench-map-ground-truth = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_ground_truth.py --json-out benchmark_results/map_ground_truth.json"
bench-map-multifield-truth = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_multifield_truth.py --json-out benchmark_results/map_multifield_truth.json"
bench-map-multifield-scale = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_multifield_truth.py --cases tan_multifield_rectangular_scale,tpv_multifield_rectangular_scale --width 2048 --height 1536 --runs 1 --torchsky-kernels bilinear --json-out benchmark_results/map_multifield_scale.json"
bench-map-multifield-random10 = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_multifield_truth.py --cases mixed_multifield_random10 --width 2048 --height 1536 --runs 1 --torchsky-kernels bilinear --json-out benchmark_results/map_multifield_random10.json"
bench-map-ground-truth-competitive-large-union = "pixi run -e sphere-bench python benchmarks/run_ground_truth_competitive_large_union.py --size 512 --json-out benchmark_results/map_ground_truth_competitive_large_union.json --markdown-out benchmark_results/map_ground_truth_competitive_large_union.md"
bench-map-ground-truth-competitive-large-union-aggregate = "pixi run -e sphere-bench python benchmarks/aggregate_ground_truth_competitive_large_union.py --json-out benchmark_results/map_ground_truth_competitive_large_union_aggregate.json --markdown-out benchmark_results/map_ground_truth_competitive_large_union_aggregate.md"
bench-map-ground-truth-competitive-large-union-rect-masked = "pixi run -e sphere-bench python benchmarks/run_ground_truth_competitive_large_union.py --case tan_random10_large_union_rect_weighted_masked --size 512 --width 512 --height 384 --json-out benchmark_results/map_ground_truth_competitive_large_union_rect_masked.json --markdown-out benchmark_results/map_ground_truth_competitive_large_union_rect_masked.md"
bench-map-ground-truth-competitive-large-union-rect-masked-aggregate = "pixi run -e sphere-bench python benchmarks/aggregate_ground_truth_competitive_large_union.py --inputs benchmark_results/map_ground_truth_competitive_large_union_rect_masked.json benchmark_results/map_ground_truth_competitive_large_union_rect_masked_1024x768.json benchmark_results/map_ground_truth_competitive_large_union_rect_masked_2048x1536.json --json-out benchmark_results/map_ground_truth_competitive_large_union_rect_masked_aggregate.json --markdown-out benchmark_results/map_ground_truth_competitive_large_union_rect_masked_aggregate.md"
bench-map-tan-sip-suite = "pixi run -e map-compat python benchmarks/bench_map_tan_sip_suite.py --profile quick --json-out benchmark_results/map_tan_sip_suite.json --markdown-out benchmark_results/map_tan_sip_suite.md"
bench-map-tan-sip-suite-full = "pixi run -e map-compat python benchmarks/bench_map_tan_sip_suite.py --profile full --json-out benchmark_results/map_tan_sip_suite_full.json --markdown-out benchmark_results/map_tan_sip_suite_full.md"
bench-map-projection-mosaic-suite = "pixi run -e map-compat python benchmarks/bench_map_projection_mosaic_suite.py --profile quick --json-out benchmark_results/map_projection_mosaic_suite.json --markdown-out benchmark_results/map_projection_mosaic_suite.md"
bench-map-projection-mosaic-suite-full = "pixi run -e map-compat python benchmarks/bench_map_projection_mosaic_suite.py --profile full --json-out benchmark_results/map_projection_mosaic_suite_full.json --markdown-out benchmark_results/map_projection_mosaic_suite_full.md"
bench-map-field-fit = "pixi run -e sphere-bench python benchmarks/bench_map_field_fit.py --json-out benchmark_results/map_field_fit.json"
bench-wcs-tpv-inverse = "pixi run -e sphere-bench python benchmarks/bench_wcs_tpv_inverse.py --json-out benchmark_results/wcs_tpv_inverse.json --markdown-out benchmark_results/wcs_tpv_inverse.md"
bench-wcs-spectral-temporal = "pixi run -e bench-all python benchmarks/bench_wcs_spectral_temporal.py --json-out benchmark_results/wcs_spectral_temporal.json"
bench-wcs-tabular = "pixi run -e bench-all python benchmarks/bench_wcs_tabular.py --json-out benchmark_results/wcs_tabular.json"
bench-map-ground-truth-gate = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_ground_truth.py --size 32 --runs 2 --cases tan_multires_noise --torchsky-kernels bilinear --json-out benchmark_results/map_ground_truth_gate.json --baseline-json benchmarks/baselines/map_ground_truth_smoke.json"
bench-map-multifield-gate = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_multifield_truth.py --size 48 --runs 2 --cases tan_multifield_cube --torchsky-kernels bilinear --json-out benchmark_results/map_multifield_gate.json --baseline-json benchmarks/baselines/map_multifield_truth_smoke.json"
bench-map-field-fit-gate = "pixi run -e sphere-bench python benchmarks/bench_map_field_fit.py --size 24 --steps 8 --runs 2 --cases tan_field_fit --models sine_implicit,coadd_bilinear --json-out benchmark_results/map_field_fit_gate.json --baseline-json benchmarks/baselines/map_field_fit_smoke.json"
bench-map-compat-gate = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_compat.py --size 32 --n-obs 2 --runs 1 --cases real_astropy_sip_fixture,real_astropy_sip_shifted_wcs,real_astropy_sip_mef,real_astropy_sip_mef_shifted_wcs --torchsky-kernels bilinear --reproject-kernels bilinear --drizzle-kernels point --swarp-kernels bilinear --json-out benchmark_results/map_compat_gate.json --baseline-json benchmarks/baselines/map_compat_real_smoke.json"
bench-map-ground-truth-gate-rep = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_ground_truth.py --size 96 --runs 3 --cases tan_multires_noise,tpv_flux_multires_mild --torchsky-kernels bilinear --json-out benchmark_results/map_ground_truth_gate_rep.json --baseline-json benchmarks/baselines/map_ground_truth_rep.json"
bench-map-multifield-gate-rep = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_map_multifield_truth.py --size 96 --runs 3 --cases tan_multifield_cube,tpv_multifield_cube --torchsky-kernels bilinear --json-out benchmark_results/map_multifield_gate_rep.json --baseline-json benchmarks/baselines/map_multifield_truth_rep.json"
bench-map-field-fit-gate-rep = "pixi run -e sphere-bench python benchmarks/bench_map_field_fit.py --size 32 --steps 24 --runs 2 --cases tan_field_fit,tan_sip_field_fit_multicolor --models sine_implicit,wire_implicit,coadd_bilinear --json-out benchmark_results/map_field_fit_gate_rep.json --baseline-json benchmarks/baselines/map_field_fit_rep.json"
bench-map-compat-external = "pixi run -e map-compat python scripts/run_local_sphere_bench.py benchmarks/bench_map_compat.py --json-out benchmark_results/map_compat_external.json"
bench-map-acceptance-smoke = "pixi run bench-map-ground-truth-gate && pixi run bench-map-multifield-gate && pixi run bench-map-field-fit-gate && pixi run bench-map-compat-gate"
bench-map-acceptance = "pixi run bench-map-ground-truth-gate-rep && pixi run bench-map-multifield-gate-rep && pixi run bench-map-field-fit-gate-rep && pixi run bench-map-compat-gate"
bootstrap-map-compat-tools = "pixi run -e map-compat python scripts/bootstrap_map_compat_tools.py --tool all"
bootstrap-map-compat-swarp = "pixi run -e map-compat python scripts/bootstrap_map_compat_tools.py --tool swarp"
bootstrap-map-compat-montage = "pixi run -e map-compat python scripts/bootstrap_map_compat_tools.py --tool montage"
bootstrap-map-compat-casutools = "pixi run -e map-compat python scripts/bootstrap_map_compat_tools.py --tool casutools"
bench-wcs-legacy = "pixi run -e bench-legacy python benchmarks/bench_all.py --profile user --wcs-only --legacy-wcs"
# Phase 0 WCS + sphere smoke baselines (see benchmarks/PHASE0_WCS_SPHERE.md); run after `pip install -e .` in bench-all.
wcs-sphere-phase0 = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --wcs-only --quick --run-id phase0_wcs --output-dir benchmarks_results && pixi run -e bench-all python benchmarks/bench_all.py --profile user --sphere-only --quick --run-id phase0_sphere --output-dir benchmarks_results"
# Plan §4: Phase 0 quick benches + full WCS/sphere pytest + spin matrix smoke.
wcs-sphere-acceptance = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --wcs-only --quick --run-id acceptance_wcs --output-dir benchmarks_results && pixi run -e bench-all python benchmarks/bench_all.py --profile user --sphere-only --quick --run-id acceptance_sphere --output-dir benchmarks_results && pixi run -e bench-all pytest tests/test_wcs_*.py tests/test_sphere_*.py -q --tb=line && pixi run -e sphere-bench python benchmarks/bench_spin_matrix.py --case-set default --runs 2 --json-out benchmarks_results/acceptance_spin_matrix.json"
# Comparator version matrix for open-source tools (see docs/benchmarks.md); run per Pixi env you use for benches.
bench-archive-scorecard = "pixi run -e default -- python scripts/archive_benchmark_scorecard.py"
bench-comparator-versions = "pixi run -e bench-all python scripts/print_benchmark_comparator_versions.py --json-out benchmarks_results/VERSIONS_comparators_bench-all.json"
bench-comparator-versions-sphere = "pixi run -e sphere-bench python scripts/print_benchmark_comparator_versions.py --json-out benchmarks_results/VERSIONS_comparators_sphere-bench.json"
bench-comparator-versions-legacy = "pixi run -e bench-legacy python scripts/print_benchmark_comparator_versions.py --json-out benchmarks_results/VERSIONS_comparators_bench-legacy.json"
bench-comparator-versions-all = "pixi run bench-comparator-versions && pixi run bench-comparator-versions-sphere && pixi run bench-comparator-versions-legacy"
# WCS suite with every in-process + legacy-bridge comparator (needs bench-legacy env + kapteyn/pyast).
bench-wcs-ecosystem = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --wcs-only --legacy-wcs --run-id wcs_ecosystem --output-dir benchmarks_results"

# Comprehensive benchmarks (renamed from exhaustive)
bench-all = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --scope all"
bench-all-keep = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --scope all --keep-temp"

# Comprehensive benchmark runner
bench-all-runner = "pixi run -e bench-all python benchmarks/bench_all.py --profile user --scope all"
bench-all-force = "pixi run -e bench-all python benchmarks/bench_all.py --profile lab --scope all"
bench-transforms = "pixi run -e bench python benchmarks/bench_transforms.py"
bench-buffer = "pixi run -e bench python benchmarks/bench_buffer.py"
bench-cache = "pixi run -e bench python benchmarks/bench_cache.py"
bench-focused = "pixi run -e bench python benchmarks/bench_transforms.py && pixi run -e bench python benchmarks/bench_buffer.py && pixi run -e bench python benchmarks/bench_cache.py"

# Pytest-based benchmarking
bench-pytest = "pytest benchmarks/ --benchmark-only"

# Development tools
notebook = "pixi run -e default -- jupyter lab"

# Test phases for development workflow
test-phase1 = "pixi run -e default -- python -c 'import sys; sys.path.insert(0, \"src\"); import torchsky; print(\"Phase 1 COMPLETE: All core features implemented\")'"
test-comprehensive = "pixi run -e default -- python examples/example_ml_pipeline.py"
test-transforms = "pixi run -e default -- pytest tests/test_transforms.py -v"
test-dataloader = "pixi run -e default -- pytest tests/test_dataloader.py -v"
test-buffer = "pixi run -e default -- pytest tests/test_buffer.py -v"
sphere-bench-bootstrap = "pixi run -e sphere-bench python scripts/bootstrap_sphere_bench.py --installer pip"
sphere-bench-bootstrap-core = "pixi run -e sphere-bench python scripts/bootstrap_sphere_bench.py --installer pip --include astropy-healpix,hpgeom,healpix,mhealpy"
sphere-bench-bootstrap-harmonics = "pixi run -e sphere-bench python scripts/bootstrap_sphere_bench.py --installer pip --with-harmonics"
sphere-upstream-sync = "pixi run -e sphere-bench python scripts/sync_upstream_sphere_sources.py --prefer-sdist --include healpy,astropy-healpix,healpix,mhealpy,spherical-geometry --output-dir benchmark_results/upstream_fixtures"
sphere-upstream-spin-matrix-gate-extended = "pixi run -e sphere-bench python benchmarks/bench_spin_matrix.py --case-set extended --runs 5 --seed 123 --json-out benchmark_results/upstream_replay_healpy_spin_matrix.json --raw-json-out benchmark_results/upstream_replay_healpy_spin_extended_raw.json --baseline-json benchmarks/baselines/spin_matrix_extended_baseline.json --max-regression-frac 0.20"
sphere-upstream-spin-matrix = "pixi run -e sphere-bench python benchmarks/bench_spin_matrix.py --case-set extended --runs 5 --json-out benchmark_results/upstream_replay_healpy_spin_matrix.json --raw-json-out benchmark_results/upstream_replay_healpy_spin_extended_raw.json"
sphere-upstream-spin-matrix-gate = "pixi run -e sphere-bench python benchmarks/bench_spin_matrix.py --case-set extended --runs 5 --seed 123 --json-out benchmark_results/upstream_replay_healpy_spin_matrix.json --raw-json-out benchmark_results/upstream_replay_healpy_spin_extended_raw.json --baseline-json benchmarks/baselines/spin_matrix_extended_baseline.json --max-regression-frac 0.20"
sphere-bench-geometry = "pixi run -e sphere-bench python benchmarks/bench_sphere_geometry.py --nside 1024 --n-points 200000 --runs 5 --device auto --sample-profile mixed --json-out benchmark_results/sphere_geometry.json --csv-out benchmark_results/sphere_geometry.csv"
sphere-bench-geometry-ecosystem = "pixi run -e sphere-bench python benchmarks/bench_sphere_geometry.py --device cpu --sample-profile mixed --nside 1024 --n-points 200000 --runs 5 --libraries torchsky,healpy,hpgeom,astropy-healpix,healpix,mhealpy --json-out benchmark_results/sphere_geometry_ecosystem.json --csv-out benchmark_results/sphere_geometry_ecosystem.csv"
sphere-bench-geometry-fast = "pixi run -e sphere-bench python benchmarks/bench_sphere_geometry.py --nside 256 --n-points 50000 --runs 3 --device auto --sample-profile mixed"
sphere-bench-geometry-matrix = "pixi run -e sphere-bench python benchmarks/bench_sphere_matrix.py --device cpu --nside 1024 --n-points 200000 --runs 5 --strict-missing --output-dir benchmark_results/sphere_matrix_latest"
sphere-bench-geometry-gate = "pixi run -e sphere-bench python benchmarks/bench_sphere_matrix.py --device cpu --nside 1024 --n-points 200000 --runs 5 --strict-missing --output-dir benchmark_results/sphere_matrix_latest --min-median-ratio-vs-healpy ang2pix_ring=1.8,ang2pix_nested=1.35,pix2ang_ring=1.15,pix2ang_nested=1.0,ring2nest=1.05,nest2ring=0.85"
sphere-bench-geometry-matrix-small = "pixi run -e sphere-bench python benchmarks/bench_sphere_matrix.py --device cpu --nside 1024 --n-points 20000 --runs 9 --strict-missing --output-dir benchmark_results/sphere_matrix_small_latest"
sphere-bench-geometry-gate-small = "pixi run -e sphere-bench python benchmarks/bench_sphere_matrix.py --device cpu --nside 1024 --n-points 20000 --runs 9 --strict-missing --output-dir benchmark_results/sphere_matrix_small_latest --min-median-ratio-vs-healpy ang2pix_ring=1.6,ang2pix_nested=1.25,pix2ang_ring=1.1,pix2ang_nested=0.95,ring2nest=1.05,nest2ring=0.85"
sphere-bench-healpix-cpu = "pixi run -e sphere-bench python benchmarks/bench_healpix.py --device cpu --sample-profile mixed --nside 1024 --n-points 200000 --runs 5 --max-index-mismatches 0 --max-pix2ang-dra-deg 1e-10 --max-pix2ang-ddec-deg 1e-10"
sphere-bench-healpix-mps = "pixi run -e sphere-bench python benchmarks/bench_healpix.py --device mps --compare-cpu --sample-profile uniform --nside 1024 --n-points 200000 --runs 5 --max-index-mismatches 10 --max-pix2ang-dra-deg 5e-4 --max-pix2ang-ddec-deg 5e-4"
sphere-bench-healpix-advanced = "pixi run -e sphere-bench python benchmarks/bench_healpix_advanced.py --device cpu --nside 1024 --n-points 200000 --runs 5 --json-out benchmark_results/healpix_advanced.json"
sphere-bench-healpix-advanced-gate = "pixi run -e sphere-bench python benchmarks/bench_healpix_advanced.py --device cpu --nside 1024 --n-points 200000 --runs 5 --min-ratio-vs-healpy neighbors_ring=1.0,neighbors_nested=0.9,interp_weights_ring=1.1,interp_weights_nested=1.1,interp_val_ring=0.9,interp_val_nested=0.95 --json-out benchmark_results/healpix_advanced.json"
sphere-bench-healpix-advanced-gate-small = "pixi run -e sphere-bench python benchmarks/bench_healpix_advanced.py --device cpu --nside 1024 --n-points 20000 --runs 9 --min-ratio-vs-healpy neighbors_ring=0.85,neighbors_nested=0.4,interp_weights_ring=1.1,interp_weights_nested=1.1,interp_val_ring=0.85,interp_val_nested=1.0 --json-out benchmark_results/healpix_advanced_small.json"
sphere-bench-core = "pixi run -e sphere-bench python benchmarks/bench_sphere_core.py --device auto --nside 256 --n-points 100000 --n-bands 8 --runs 5 --json-out benchmark_results/sphere_core.json"
sphere-bench-polygons = "pixi run -e sphere-bench python scripts/run_local_sphere_bench.py benchmarks/bench_sphere_polygons.py --nside 512 --n-points 200000 --runs 5 --json-out benchmark_results/sphere_polygons.json"
sphere-bench-geom-exact-contains = "pixi run -e sphere-bench python benchmarks/bench_sphere_geom_exact_contains.py --n-points 200000 --runs 5 --json-out benchmark_results/sphere_geom_exact_contains.json"
sphere-bench-geom-exact-contains-gate = "pixi run -e sphere-bench python benchmarks/bench_sphere_geom_exact_contains.py --n-points 200000 --runs 5 --json-out benchmark_results/sphere_geom_exact_contains.json --baseline-json benchmarks/baselines/sphere_geom_exact_contains_gate.json"
sphere-bench-catalog-crossmatch = "pixi run -e sphere-bench python benchmarks/bench_catalog_crossmatch.py --n-left 20000 --n-right-band 250000 --n-right-background 50000 --radius-arcsec 2.0 --runs 5 --json-out benchmark_results/catalog_crossmatch.json"
sphere-bench-catalog-compat = "pixi run -e sphere-bench python benchmarks/bench_catalog_compat.py --n-left 10000 --n-right-noise 80000 --radius-arcsec 2.0 --runs 5 --json-out benchmark_results/catalog_compat.json"
sphere-bench-spectral = "pixi run -e sphere-bench python benchmarks/bench_sphere_spectral.py --nside 32 --lmax 32 --runs 7 --json-out benchmark_results/sphere_spectral.json"
sphere-bench-sparse = "pixi run -e sphere-bench python benchmarks/bench_sphere_sparse.py --nside 512 --coverage-frac 0.1 --n-queries 200000 --runs 5 --json-out benchmark_results/sphere_sparse.json"
sphere-bench-sparse-gate = "pixi run -e sphere-bench python benchmarks/bench_sphere_sparse.py --nside 512 --coverage-frac 0.1 --n-queries 200000 --runs 5 --min-ratio-sparse-udgrade-vs-dense 1.0 --json-out benchmark_results/sphere_sparse.json"
sphere-bench-pipeline = "pixi run -e sphere-bench python benchmarks/bench_pipeline_table_sphere.py --n-rows 1000000 --runs 3 --nside 256 --json-out benchmark_results/pipeline_table_sphere.json"
sphere-bench-pipeline-gate = "pixi run -e sphere-bench python benchmarks/bench_pipeline_table_sphere.py --n-rows 1000000 --runs 3 --nside 256 --min-read-ratio-filtered-vs-torch 0.2 --min-pipeline-ratio-filtered-vs-no-pushdown 0.7 --min-pipeline-ratio-torch-vs-no-pushdown 0.7 --json-out benchmark_results/pipeline_table_sphere.json"

[feature.prod.dependencies]
python = ">=3.12,<3.14"

# Test feature with comparison libraries
