# Environment definitions
[environments]
default = { features = ["prod"], solve-group = "default" }
test = { features = ["prod", "test"], solve-group = "default" }
bench = { features = ["prod", "bench"], solve-group = "default" }
sphere-bench = { features = ["prod", "bench", "sphere-bench"], solve-group = "default" }
bench-all = { features = ["prod", "bench", "sphere-bench"], solve-group = "default" }
map-compat = { features = ["prod", "bench", "sphere-bench", "map-compat"], solve-group = "map-compat" }
bench-legacy = { features = ["bench-legacy"], solve-group = "bench-legacy" }
cuda = { features = ["prod", "test", "cuda"], solve-group = "cuda" }
hybpsf = ["hybpsf"]
jwstpipe = { features = ["jwstpipe"], no-default-feature = true }
